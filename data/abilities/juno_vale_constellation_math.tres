[resource]
script = ExtResource( 1 )
id = "juno_vale_constellation_math"
name = "Constellation Math"
description = "Links two allies who share no traits. The constellation grants them mana and pulses along their line, pushing crossing enemies away."
targeting_summary = "Prefers a pair of living non-Juno allies with no shared traits; only enemies crossing their visible line are moved."
base_cost = 60
tags = ["support", "mana", "line", "disrupt"]
