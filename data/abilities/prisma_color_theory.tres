[resource]
script = ExtResource( 1 )
id = "prisma_color_theory"
name = "Color Theory"
description = "Paints one persistent prism field. Enemies take damage once and cannot gain mana only while they remain inside its visible boundary."
targeting_summary = "Prioritizes divers and engagers, then clustered enemies; spreading reduces occupants and leaving ends mana denial."
base_cost = 60
tags = ["damage", "zone", "mana_denial", "aoe"]
