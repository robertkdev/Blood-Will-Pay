id = "creep_playable_eavesdropping"
name = "Eavesdropping"
description = "Dashes to the lowest-health back-half enemy and spins in place. Creep takes reduced damage but can be controlled; the first takedown allows one chase."
targeting_summary = "Lowest-health enemy from the enemy backline half; spreading reduces spin victims and denying the first takedown prevents the chase."
