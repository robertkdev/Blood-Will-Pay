[ext_resource path="res://scripts/game/abilities/ability_def.gd" type="Script" id=1]

[resource]
script = ExtResource( 1 )
id = "egress_exit_wound"
name = "Exit Wound"
description = "Marks a wounded backliner, strikes once, and executes only if they were already below 30% Health. Egress retreats only after a kill."
targeting_summary = "Lowest-health enemy from the enemy backline half; shields and healing during the tell can deny the execute."
base_cost = 30
tags = ["damage", "execute", "retreat"]
